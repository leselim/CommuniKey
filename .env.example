# Environment Configuration for Community Cloud Platform

# Django Backend Settings
DEBUG=1
SECRET_KEY=django-insecure-change-this-in-production-key-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
USE_POSTGRES=1
DB_NAME=community_cloud_db
DB_USER=ccp_user
DB_PASSWORD=ccp_password
DB_HOST=localhost
DB_PORT=5432

# React Frontend Settings
REACT_APP_API_URL=http://localhost:8000/api/v1

# AWS Deployment Configuration (Used by Terraform & Production Deployment)
AWS_REGION=eu-west-1
AWS_ENVIRONMENT=dev
PROJECT_NAME=community-cloud-platform
